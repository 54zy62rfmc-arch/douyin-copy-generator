# ===== 大模型 API（OpenAI 兼容协议）=====
# LLM_API_KEY 留空时，应用会自动进入「演示模式」：
# 用内置爆款模板生成文案，功能完整可体验，无需任何 Key。
LLM_API_KEY=

# 常见服务商 Base URL（都兼容 OpenAI 协议，改这里 + LLM_MODEL 即可切换）：
#   OpenAI      https://api.openai.com/v1
#   DeepSeek    https://api.deepseek.com/v1
#   通义千问    https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM    https://open.bigmodel.cn/api/paas/v4
#   月之暗面    https://api.moonshot.cn/v1
#   火山方舟    https://ark.cn-beijing.volces.com/api/v3
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 模型回退列表（按顺序尝试，用逗号分隔）。留空时仅使用 LLM_MODEL。
# 例：LLM_MODELS=deepseek-chat,gpt-4o-mini
LLM_MODELS=

# 识图模型（需支持视觉输入，如 gpt-4o / qwen-vl-max / glm-4v）。留空则复用 LLM_MODEL。
LLM_VISION_MODEL=

# 生成参数
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=2600

# 单个模型失败重试次数（含首次共 retries+1 次请求）
LLM_RETRIES=2

# 出网代理（服务器在国内、调用海外模型时填写，如 http://127.0.0.1:7890）
# 不填则自动读取系统 HTTPS_PROXY / HTTP_PROXY 环境变量
LLM_PROXY=

# 服务端口
PORT=8000

# ===== 访问控制 =====
# 固定访问口令。设置后所有接口需带 X-Access-Token 头（或 ?token=）。
# 留空时可在 App「设置 → 访问口令」里动态设置（保存在数据目录）。
ACCESS_TOKEN=

# 每 IP 每分钟请求上限（0 表示不限流）
RATE_LIMIT=60

# ===== 数据目录 =====
# 历史 / 热词 / 爆款样本 / 访问口令的持久化目录
DATA_DIR=./.data

# ===== 可选 HTTPS（PWA 完整安装建议启用）=====
# 填入证书与私钥路径即可自动以 HTTPS 启动
TLS_CERT=
TLS_KEY=

